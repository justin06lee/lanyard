{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanyard",
  "mainBinaryName": "lanyard",
  "version": "0.2.1",
  "identifier": "dev.justin06lee.lanyard",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDOENGN0IwODg3NjdEMTgKUldRWWZYYUlzUGVNM01TN0w0S0NWNzkwalBKclVobTg0bVpIWXU5bWwxVlZVNWxSZElPeWdnVWcK",
      "endpoints": [
        "https://github.com/justin06lee/lanyard/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
